---
// アプリのサポート・規約と、決済の完了・取消の画面。本文は旧サイトの HTML をそのまま差し込む（src/legal/*.html）。
// 本文の見た目は global.css の「移したページ」節。本文を直すときは、アプリストアの掲載情報と食い違わないか先に確かめる。
import Base from './Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbLd } from '../lib/breadcrumb.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  h1: string;
  h1Sub?: string;
  appName?: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
  content: string;
}
const { title, description, noindex = false, h1, h1Sub, appName, lead, crumbs, content } = Astro.props;
// 本文の文字は変えずに、読み方と見え方だけを整える（見える本文が変わらないことは scripts/check_legal_text.py が照合する）
//   - 編集用のコメント（<!-- 日本語 --> など）は読者に届けない
//   - 表は横スクロールの枠で包む（狭い画面で本文ごとはみ出さないように。DADS テーブル）
//   - 名前の無いアイコン（飾り）は読み上げない
let tableNo = 0;
const body = content
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/<table\b[\s\S]*?<\/table>/g, (t) => `<div class="table-region" role="region" tabindex="0" aria-label="表${++tableNo}">${t}</div>`)
  .replace(/<svg\b(?![^>]*\b(?:aria-hidden|aria-label|role)=)/g, '<svg aria-hidden="true" focusable="false"');
---

<Base title={title} description={description} noindex={noindex} jsonLd={crumbs ? [breadcrumbLd(crumbs, Astro.url.pathname)] : []}>
  {crumbs && <Breadcrumb items={crumbs} />}
  <div class="wrap narrow page-head">
    <h1>
      {h1}
      {h1Sub && <span class="h1-sub" lang="en">{h1Sub}</span>}
    </h1>
    {appName && <p class="page-head__lead">{appName}</p>}
    {lead && <p class="page-head__lead">{lead}</p>}
  </div>
  <div class="wrap narrow page-body">
    <div class="legal" set:html={body} />
  </div>
</Base>
