---
// LP の見本の棚（トップ・サービス・つくったもので共用）。見本 1 つにつき、パソコンの画面を左（1〜7 列）、
// 説明とスマートフォンの画面を右（8〜12 列）に置く。狭い画面ではスマートフォンの画面だけを出す（パソコンの画面を縮めると読めない）。
// 画像が無い見本は出さない（仮の枠や絵は置かない）。架空の店であることと段・料金を、画面の横に必ず書く（誤認させない）。
import { Picture } from 'astro:assets';
import prices from '../data/prices.json';
import { SAMPLES, SAMPLE_NOTES } from '../data/samples.mjs';
import { TIERS } from '../data/tiers.mjs';
import { jaDate } from '../lib/date.mjs';
import { yen } from '../lib/format.mjs';
import { tax } from '../lib/prices.mjs';

interface Props {
  /** 見本 1 つずつの見出しの段（節の見出しの 1 つ下） */
  level?: 'h3' | 'h4';
}
const { level = 'h3' } = Astro.props;
const Heading = level;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/samples/*.webp', { eager: true });
const shelf = SAMPLES.map((s) => ({
  ...s,
  pc: images[`../assets/samples/${s.id}-pc.webp`]?.default,
  sp: images[`../assets/samples/${s.id}-sp.webp`]?.default,
  label: TIERS[s.tier].label,
  bundle: prices.plans[`bundle_${s.tier}`],
  standalone: prices.plans[`standalone_${s.tier}`],
})).filter((s) => s.pc && s.sp);
---

{
  shelf.length > 0 && (
    <div class="samples">
      {shelf.map((s) => (
        <figure class="sample">
          <div class="grid sample__grid">
            <div class="grid__main sample__pc">
              <Picture
                src={s.pc}
                alt={s.alt.pc}
                widths={[640, 960, 1280]}
                sizes="(min-width: 72rem) 40rem, 55vw"
                formats={['avif', 'webp']}
              />
            </div>
            <div class="grid__side sample__side">
              <figcaption class="sample__caption">
                <Heading class="sample__title">{s.label}の見本</Heading>
                <p class="sample__shop">
                  {s.shop}（{s.industry}・架空の店）
                </p>
                <dl class="facts">
                  <div>
                    <dt>料金</dt>
                    <dd>
                      LP＋保守 {yen(s.bundle.price)}、LP単体 {yen(s.standalone.price)}（{tax}）
                    </dd>
                  </div>
                  <div>
                    <dt>納期</dt>
                    <dd>最短{s.bundle.delivery_days}</dd>
                  </div>
                  <div>
                    <dt>画面</dt>
                    <dd>
                      {jaDate(s.shotAt)}に撮影（見本は{jaDate(s.madeAt)}に作成）
                    </dd>
                  </div>
                </dl>
              </figcaption>
              <div class="sample__sp">
                <Picture src={s.sp} alt={s.alt.sp} widths={[240, 360, 480]} sizes="(min-width: 48rem) 12rem, 18rem" formats={['avif', 'webp']} />
              </div>
            </div>
          </div>
        </figure>
      ))}
      <ul class="sample-notes">
        {SAMPLE_NOTES.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    </div>
  )
}
