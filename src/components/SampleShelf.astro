---
// LP の見本の展示（トップ・サービス・つくったもので共用）。見本 1 つにつき、画面の組を 1〜8 列、説明を 9〜12 列に置く。
// 左右は入れ替えない（NN/g: 画像を左右交互に置くと流し読みしにくい）。見本と見本の間は広くとる（展示の間隔が格を上げる）。
// 画像が無い見本は出さない（仮の枠や絵は置かない）。架空の店であること・段・料金と条件・撮影日を必ず書く（誤認させない）。
// 画像はリンクにせず、ホバーの動きも付けない（押せない物に反応を付けない）。
import ShotPair from './ShotPair.astro';
import prices from '../data/prices.json';
import { SAMPLES, SAMPLE_NOTES } from '../data/samples.mjs';
import { TIERS } from '../data/tiers.mjs';
import { jaDate } from '../lib/date.mjs';
import { yen } from '../lib/format.mjs';
import { careFrom, tax } from '../lib/prices.mjs';

interface Props {
  /** 見本 1 つずつの見出しの段（節の見出しの 1 つ下） */
  level?: 'h3' | 'h4';
}
const { level = 'h3' } = Astro.props;
const Heading = level;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/samples/*.webp', { eager: true });
// 看板に置いた見本は最後に回す（看板の直後に同じ画面を続けない）
const shelf = [...SAMPLES].sort((a, b) => Number(Boolean(a.hero)) - Number(Boolean(b.hero))).map((s) => ({
  ...s,
  pc: images[`../assets/samples/${s.id}-pc.webp`]?.default,
  sp: images[`../assets/samples/${s.id}-sp.webp`]?.default,
  label: TIERS[s.tier].label,
  bundle: prices.plans[`bundle_${s.tier}`],
  standalone: prices.plans[`standalone_${s.tier}`],
})).filter((s) => s.pc && s.sp);
---

{
  shelf.length > 0 && (
    <div class="samples">
      {shelf.map((s) => (
        <figure class="sample exhibit">
          <div class="exhibit__media shot-pair shot-pair--exhibit">
            <ShotPair
              pc={s.pc!}
              sp={s.sp!}
              alt={s.alt}
              sizes={{ pc: '(min-width: 72rem) 41rem, (min-width: 48rem) 52vw, calc(100vw - 6rem)', sp: '(min-width: 72rem) 12.5rem, (min-width: 48rem) 16vw, 36vw' }}
            />
          </div>
          <figcaption class="exhibit__info">
            <Heading class="exhibit__title">{s.label}の見本</Heading>
            <p class="exhibit__shop">
              {s.shop}（{s.industry}・架空の店）
            </p>
            <p class="exhibit__price mincho" data-font="mincho">
              {yen(s.bundle.price)}
            </p>
            <p class="exhibit__terms">
              LP＋保守の制作料金です（{tax}）。保守メンテナンス（月{yen(careFrom)}から）とあわせてのお申し込みです。LP だけなら{yen(s.standalone.price)}（{tax}）です。
            </p>
            <dl class="facts">
              <div>
                <dt>納期</dt>
                <dd>お支払いの確認から、確認用の実物まで最短{s.bundle.delivery_days}</dd>
              </div>
              <div>
                <dt>画面</dt>
                <dd>
                  {jaDate(s.shotAt)}に撮影（見本は{jaDate(s.madeAt)}に作成）
                </dd>
              </div>
            </dl>
          </figcaption>
        </figure>
      ))}
      <ul class="sample-notes">
        {SAMPLE_NOTES.map((n) => (
          <li>{n}</li>
        ))}
      </ul>
    </div>
  )
}
