---
// エレノアの印。赤と青の四角が重なり、重なった部分が紫（ブランド色 #7b3a87＝赤と青の平均）。
// 「赤と青が混ざって紫」はこの印だけで表す（面をグラデーションで塗らない。DESIGN.md §1）。
// 赤は「つくる」、青は「見続ける」、重なりは「エレノアが引き受けるところ」。
// 座標は偶数だけにしている（16px に縮めても面の端が画素に合う）。public/favicon.svg とアイコン類は同じ形の書き出し
// （tools/preview/icons.html）。形を変えたら両方を描き直す。
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" focusable="false">
  <rect x="2" y="8" width="20" height="22" fill="#d7263d"></rect>
  <rect x="10" y="2" width="20" height="20" fill="#1f4fd1"></rect>
  <rect x="10" y="8" width="12" height="14" fill="#7b3a87"></rect>
</svg>
