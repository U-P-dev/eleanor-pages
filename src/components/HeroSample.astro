---
// 看板の見本の画面（主力の LP の見本。NN/g: 主画像は主力の提供物を代表させる）。大胆に見せるのはここだけ（DESIGN.md §1）。
// PC の画面は 6 列目から窓の右端まで裁ち落とし、SP の画面を同じ縮尺で手前に重ねる。
// 最初の画面に入るので遅延読み込みにしない（web.dev）。料金は書かない（料金は条件と一緒に下の節で出す）。画像が無ければ何も出さない。
import ShotPair from './ShotPair.astro';
import { SAMPLES } from '../data/samples.mjs';
import { TIERS } from '../data/tiers.mjs';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/samples/*.webp', { eager: true });
const s = SAMPLES.find((x) => x.hero) ?? SAMPLES[0];
const pc = images[`../assets/samples/${s.id}-pc.webp`]?.default;
const sp = images[`../assets/samples/${s.id}-sp.webp`]?.default;
---

{
  pc && sp && (
    <figure class="hero__media shot-pair shot-pair--hero">
      <ShotPair
        pc={pc}
        sp={sp}
        alt={{ pc: `${s.alt.pc}（見本・架空の店）`, sp: `${s.alt.sp}（見本・架空の店）` }}
        sizes={{ pc: '(min-width: 64rem) 57vw, calc(100vw - 4.5rem)', sp: '(min-width: 64rem) 18vw, 36vw' }}
        priority
      />
      <figcaption class="shot-pair__note hero__caption">
        見本：架空の{s.industry}の LP（{TIERS[s.tier].label}）
      </figcaption>
    </figure>
  )
}
