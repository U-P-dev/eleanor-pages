---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PriceTables from '../components/PriceTables.astro';
import prices from '../data/prices.json';
import { faqs } from '../data/faq.mjs';
import { breadcrumbLd } from '../lib/breadcrumb.mjs';
import { faqPage } from '../lib/jsonld.mjs';
import { yen } from '../lib/format.mjs';
import { SITE } from '../site.mjs';

type Plan = { name: string; price: number; delivery_days?: string; includes?: string[]; included_pages?: number; extra_page_price?: number };
type Row = { name: string; price: number; billing?: string; description?: string; delivery_days?: string };
const plans = prices.plans as Record<string, Plan>;
const full = prices.fullorder as Record<string, Plan>;
const subs = Object.values(prices.subscriptions) as Row[];
const addons = Object.values(prices.addons) as Row[];
const spots = Object.values(prices.spot) as Row[];
const tax = prices.tax_included ? '税込' : '税抜';
const careFrom = Math.min(...subs.filter((s) => s.billing === '月額').map((s) => s.price));
const bundle = plans.bundle_standard;
const standalone = plans.standalone_standard;
const buyoutQa = faqs.find((f) => f.q.startsWith('保守をやめたら'));
const crumbs = [{ label: 'サービス' }];
const url = new URL(Astro.url.pathname, SITE.url).href;
---

<Base
  title={`サービスと料金（LP 制作・ホームページ制作・保守）｜${SITE.name}`}
  description={`LP の制作（${yen(bundle.price)}から）、ホームページのフルオーダー制作、公開後の保守と運用（月${yen(careFrom)}から）。各プランに含まれるもの、保守をやめるときの条件、よくある質問をまとめています。`}
  jsonLd={[breadcrumbLd(crumbs, Astro.url.pathname), faqPage({ url, items: faqs })]}
>
  <Breadcrumb items={crumbs} />
  <div class="wrap page-head">
    <h1>サービスと料金</h1>
    <p class="page-head__lead">
      お店と小さな会社のサイトを、つくるところから公開後の保守まで引き受けます。料金はすべて{tax}で表示しています。
    </p>
  </div>

  <div class="wrap page-body">
    <section class="section" id="lp-plans" aria-labelledby="lp-plans-title">
      <h2 id="lp-plans-title">LP の制作</h2>
      <p class="section__lead">
        1ページで伝えるサイトを、制作者が1点ずつ確認したデザインから選んでつくります。やりとりはすべてメールで、お打ち合わせはありません。
      </p>
      <PriceTables lpOnly />
      <h3 class="table-caption" id="lp-compare-title">LP＋保守と LP単体のちがい</h3>
      <div class="table-region table--stack" role="region" tabindex="0" aria-labelledby="lp-compare-title">
        <table role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col"><span class="visually-hidden">項目</span></th>
              <th role="columnheader" scope="col">{bundle.name}</th>
              <th role="columnheader" scope="col">{standalone.name}</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            <tr role="row">
              <th role="rowheader" scope="row">制作料金</th>
              <td role="cell" class="num" data-label={bundle.name}>{yen(bundle.price)}から</td>
              <td role="cell" class="num" data-label={standalone.name}>{yen(standalone.price)}から</td>
            </tr>
            <tr role="row">
              <th role="rowheader" scope="row">公開</th>
              <td role="cell" class="desc" data-label={bundle.name}>エレノアが公開し、そのまま保守を続けます</td>
              <td role="cell" class="desc" data-label={standalone.name}>HTML 一式をお渡しします。公開はお客様の環境で行っていただきます</td>
            </tr>
            <tr role="row">
              <th role="rowheader" scope="row">保守メンテナンス</th>
              <td role="cell" class="desc" data-label={bundle.name}>月額でお申し込み（月{yen(careFrom)}から）</td>
              <td role="cell" class="desc" data-label={standalone.name}>含みません</td>
            </tr>
            <tr role="row">
              <th role="rowheader" scope="row">含まれるもの</th>
              <td role="cell" class="desc" data-label={bundle.name}><ul class="check-list">{bundle.includes?.map((i) => <li>{i}</li>)}</ul></td>
              <td role="cell" class="desc" data-label={standalone.name}><ul class="check-list">{standalone.includes?.map((i) => <li>{i}</li>)}</ul></td>
            </tr>
            <tr role="row">
              <th role="rowheader" scope="row">保守をやめるとき</th>
              <td role="cell" class="desc" data-label={bundle.name} set:html={buyoutQa?.html} />
              <td role="cell" class="desc" data-label={standalone.name}>保守を含まないプランです</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section--minor" id="fullorder" aria-labelledby="fullorder-title">
      <h2 class="section__title" id="fullorder-title">フルオーダー（ホームページ・つくり込みの LP）</h2>
      <p class="section__lead">
        オンラインのお打ち合わせから、構成と原稿をつくります。テンプレートに収まらないもの、ページ数の多いホームページはこちらです。
      </p>
      <div class="table-region table--stack" role="region" tabindex="0" aria-labelledby="fullorder-title">
        <table role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col"><span class="visually-hidden">項目</span></th>
              {Object.values(full).map((f) => <th role="columnheader" scope="col">{f.name}</th>)}
            </tr>
          </thead>
          <tbody role="rowgroup">
            <tr role="row">
              <th role="rowheader" scope="row">料金</th>
              {
                Object.values(full).map((f) => (
                  <td role="cell" class="num" data-label={f.name}>
                    {yen(f.price)}
                    {f.included_pages && f.extra_page_price && (
                      <>
                        <br />
                        <span class="table-note">
                          {f.included_pages}ページまで。以降1ページ{yen(f.extra_page_price)}
                        </span>
                      </>
                    )}
                  </td>
                ))
              }
            </tr>
            <tr role="row">
              <th role="rowheader" scope="row">納期</th>
              {Object.values(full).map((f) => <td role="cell" class="nowrap" data-label={f.name}>{f.delivery_days}</td>)}
            </tr>
            <tr role="row">
              <th role="rowheader" scope="row">含まれるもの</th>
              {
                Object.values(full).map((f) => (
                  <td role="cell" class="desc" data-label={f.name}>
                    <ul class="check-list">{f.includes?.map((i) => <li>{i}</li>)}</ul>
                  </td>
                ))
              }
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section--minor" id="extend" aria-labelledby="extend-title">
      <h2 class="section__title" id="extend-title">LP・ホームページに付随する機能の開発</h2>
      <div class="prose">
        <p>
          つくったサイトを、お店や会社の仕事とつなぐ開発もお引き受けします。フルオーダーのお打ち合わせの中でご相談ください。金額は内容をうかがってからお見積もりします。
        </p>
        <ul class="check-list">
          <li>予約サービス・問い合わせフォーム・LINE 公式アカウントとの連携</li>
          <li>問い合わせの受け付けや返信まわりの手間を減らす仕組み</li>
          <li>いまお使いのサイト・ドメイン・サーバーの移行</li>
          <li>公開後に自分たちで更新できる形への作り替え</li>
        </ul>
        <p>お問い合わせの種類で「フルオーダー・その他相談」を選び、いまの状況とお困りごとをお書きください。</p>
      </div>
    </section>

    <section class="section section--minor" id="care" aria-labelledby="care-title">
      <h2 class="section__title" id="care-title">保守と運用</h2>
      <p class="section__lead">公開したサイトを、決まった間隔で確かめ、掲載内容の差し替えにも応じます。</p>
      <div class="table-region table--stack" role="region" tabindex="0" aria-labelledby="care-title">
        <table role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col">プラン</th>
              <th role="columnheader" scope="col">料金</th>
              <th role="columnheader" scope="col">内容</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              subs.map((s) => (
                <tr role="row">
                  <th role="rowheader" scope="row">{s.name}</th>
                  <td role="cell" class="num" data-label="料金">
                    {yen(s.price)}／{s.billing === '年額' ? '年' : '月'}
                  </td>
                  <td role="cell" class="desc" data-label="内容">{s.description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="section section--minor" id="options" aria-labelledby="options-title">
      <h2 class="section__title" id="options-title">追加サービス・スポット対応</h2>
      <h3 class="table-caption" id="addons-title">追加サービス（保守メンテナンスとあわせて）</h3>
      <div class="table-region table--stack" role="region" tabindex="0" aria-labelledby="addons-title">
        <table role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col">サービス</th>
              <th role="columnheader" scope="col">料金</th>
              <th role="columnheader" scope="col">内容</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              addons.map((a) => (
                <tr role="row">
                  <th role="rowheader" scope="row">{a.name}</th>
                  <td role="cell" class="num" data-label="料金">
                    {yen(a.price)}／{a.billing === '年額' ? '年' : '月'}
                  </td>
                  <td role="cell" class="desc" data-label="内容">{a.description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <h3 class="table-caption" id="spot-title">スポット対応（1回ごと）</h3>
      <div class="table-region" role="region" tabindex="0" aria-labelledby="spot-title">
        <table>
          <thead>
            <tr>
              <th scope="col">内容</th>
              <th scope="col">料金</th>
            </tr>
          </thead>
          <tbody>
            {
              spots.map((s) => (
                <tr>
                  <th scope="row">{s.name}</th>
                  <td class="num">{yen(s.price)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">
        料金は{tax}です（別途消費税{Math.round(prices.tax_rate * 100)}%）。取引の条件の全文は<a href="/tokusho.html">特定商取引法に基づく表示</a>をご覧ください。
      </p>
    </section>

    <section class="section section--minor" id="faq" aria-labelledby="faq-title">
      <h2 class="section__title" id="faq-title">よくある質問</h2>
      <div class="qa">
        {
          faqs.map((f) => (
            <div class="qa__item">
              <h3 class="qa__q">{f.q}</h3>
              <div class="qa__a">
                <p set:html={f.html} />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section section--minor page-end" aria-labelledby="services-end">
      <h2 id="services-end">どのプランが合うか迷ったら</h2>
      <p>いまのお困りごとをお書きいただければ、合うプランと費用の目安をメールでお返事します。ご相談は無料です。</p>
      <div class="button-row">
        <a class="button button--primary button--large" href="/#contact">相談する</a>
      </div>
    </section>
  </div>
</Base>
