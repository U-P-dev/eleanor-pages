---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import News from '../components/News.astro';
import Person from '../components/Person.astro';
import prices from '../data/prices.json';
import { breadcrumbLd } from '../lib/breadcrumb.mjs';
import { ORG_ID, organization } from '../lib/jsonld.mjs';
import { jaDate, jaMonth } from '../lib/date.mjs';
import updated from '../data/updated.json';
import { SITE } from '../site.mjs';

const crumbs = [{ label: '会社概要' }];
const op = SITE.operator;
---

<Base
  title={`会社概要・代表プロフィール｜${SITE.name}（東京・新宿）`}
  description="エレノア（Eleanor）の事業者情報と代表のプロフィール。東京都新宿区の個人事業で、お店と小さな会社のホームページ・LP の制作と、公開後の保守・運用を引き受けています。全国からメールとオンラインでご依頼をお受けします。"
  pageType="AboutPage"
  jsonLd={[breadcrumbLd(crumbs, Astro.url.pathname), organization({ full: true }), { '@id': `${new URL(Astro.url.pathname, SITE.url).href}#webpage`, mainEntity: { '@id': ORG_ID } }]}
>
  <Breadcrumb items={crumbs} />
  <div class="wrap page-head">
    <h1>会社概要</h1>
    <p class="page-head__lead">
      エレノアは、ひとりの開発者が営む個人事業です。ご相談の窓口から公開後の保守まで、同じ人間が担当します。
    </p>
  </div>

  <div class="wrap page-body">
    <section class="section" aria-labelledby="message-title">
      <Person headingId="message-title" heading="代表から">
        <p>
          サイトは、公開した日から働きはじめます。それなのに、つくった人が公開の日に手を離してしまうと、直したいところが出てきたときに頼める相手がいません。
        </p>
        <p>
          エレノアは、つくった本人が公開後も保守を続けることを前提に、料金と進め方を組み立てています。途中で担当が替わらないので、事情を一から説明し直す必要がありません。自分のサービスも自分でつくって運営し、そこで確かめたやり方をお客様のサイトに使っています。
        </p>
      </Person>
    </section>

    <section class="section section--minor" id="profile" aria-labelledby="profile-title">
      <h2 class="section__title" id="profile-title">代表のプロフィール</h2>
      <dl class="dl">
        <div>
          <dt>代表</dt>
          <dd>{op.representative}（とよしま ゆうすけ）</dd>
        </div>
        <div>
          <dt>現在</dt>
          <dd>外資系コンサルティングファームに勤務</dd>
        </div>
        <div>
          <dt>以前</dt>
          <dd>外資系企業のシステムエンジニア（SE）</dd>
        </div>
        <div>
          <dt>得意なこと</dt>
          <dd>クラウドを使ったサイトとシステムの設計。お店や会社の仕事の流れに合わせて、公開後も手のかからない仕組みを組み立てること</dd>
        </div>
      </dl>
    </section>

    <section class="section section--minor" id="info" aria-labelledby="info-title">
      <h2 class="section__title" id="info-title">事業者情報</h2>
      <dl class="dl">
        <div>
          <dt>屋号</dt>
          <dd>{op.name}（{op.nameEn}）</dd>
        </div>
        <div>
          <dt>代表者</dt>
          <dd>{op.representative}</dd>
        </div>
        <div>
          <dt>事業形態</dt>
          <dd>個人事業</dd>
        </div>
        <div>
          <dt>開業</dt>
          <dd>{jaMonth(op.founded)}</dd>
        </div>
        <div>
          <dt>事業内容</dt>
          <dd>
            ホームページ・LP の制作と保守・運用<br />LP・ホームページに付随する機能の開発<br />自社のウェブサービス・アプリの企画・開発・運営
          </dd>
        </div>
        <div>
          <dt>所在地</dt>
          <dd>〒{op.postalCode}<br />{op.address}</dd>
        </div>
        <div>
          <dt>対応地域</dt>
          <dd>{SITE.area}</dd>
        </div>
        <div>
          <dt>ご来訪</dt>
          <dd>所在地へのご来訪と、対面でのお打ち合わせはお受けしていません。</dd>
        </div>
        <div>
          <dt>お客様</dt>
          <dd>事業者の方（お店・会社）向けのサービスです（<a href="/terms-lp.html">利用規約</a> 第3条）。</dd>
        </div>
        <div>
          <dt>電話番号</dt>
          <dd>{op.phone}（受付時間 {op.hours.label}。{op.hours.note}）</dd>
        </div>
        <div>
          <dt>メール</dt>
          <dd><a href={`mailto:${op.email}`}>{op.email}</a></dd>
        </div>
        <div>
          <dt>お返事</dt>
          <dd>お問い合わせには、{op.reply}。営業日は{op.businessDays}です。</dd>
        </div>
        <div>
          <dt>インボイス</dt>
          <dd>
            {
              prices.invoice_registered && prices.invoice_number
                ? `適格請求書発行事業者の登録番号 ${prices.invoice_number}`
                : '適格請求書発行事業者の登録を申請しています。登録番号は、通知が届きしだい載せます。'
            }
          </dd>
        </div>
        <div>
          <dt>最終更新</dt>
          <dd><time datetime={updated['/company.html']}>{jaDate(updated['/company.html'])}</time></dd>
        </div>
      </dl>
    </section>

    <section class="section section--minor" id="history" aria-labelledby="history-title">
      <h2 class="section__title" id="history-title">これまでの歩み</h2>
      <News kind="history" />
    </section>

    <section class="section section--minor page-end" aria-labelledby="company-end">
      <h2 id="company-end">ご相談はお問い合わせから</h2>
      <p>ご相談・お見積もりは無料です。いまのお困りごとをお書きください。</p>
      <div class="button-row">
        <a class="button button--primary button--large" href="/contact.html">相談する</a>
      </div>
    </section>
  </div>
</Base>
