---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Person from '../components/Person.astro';
import PriceTables from '../components/PriceTables.astro';
import prices from '../data/prices.json';
import kaiyakuPc from '../assets/shots/kaiyaku-top-pc.webp';
import kaiyakuSp from '../assets/shots/kaiyaku-article-sp.webp';
import { publishedPosts, postUrl } from '../lib/blog.mjs';
import { jaDate, ymd } from '../lib/date.mjs';
import { yen } from '../lib/format.mjs';
import { SITE, WORKS } from '../site.mjs';

const minOf = (rows: Record<string, { price: number; billing?: string }>, monthlyOnly = false) =>
  Math.min(...Object.values(rows).filter((r) => !monthlyOnly || r.billing === '月額').map((r) => r.price));
const lpFrom = minOf(prices.plans);
const careFrom = minOf(prices.subscriptions, true);
const hp = prices.fullorder.fullorder_hp;
const bundleFrom = prices.plans.bundle_standard.price;
const standaloneFrom = prices.plans.standalone_standard.price;
const fastest = prices.plans.bundle_standard.delivery_days;
// 含まれるものの短い項目（原稿・フォーム・解析）。料金データの文言をそのまま使う（ここで書き直すと約束の文言とずれる）
const lpIncludes = prices.plans.bundle_standard.includes.filter((i) => i.length <= 20);
const tax = prices.tax_included ? '税込' : '税抜';
// トップのブログ欄は、記事が 3 本たまるまで出さない（1 本だけの欄は「更新が止まっている」に見える。2026-09-24 の目隠しの確認）
const allPosts = await publishedPosts();
const posts = allPosts.length >= 3 ? allPosts.slice(0, 3) : [];
const kaiyaku = WORKS.kaiyaku;
const op = SITE.operator;
---

<Base title={`ホームページと LP の制作・保守｜東京・新宿の${SITE.name}`} description={SITE.description}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap grid hero__inner">
      <div class="grid__main hero__text">
        <h1 class="hero__title" id="hero-title">
          <span class="hero__copy">
            <span class="hero__line">「つくって終わり」。</span>
            <span class="hero__line">に、しない。</span>
          </span>
          <span class="hero__what">お店と小さな会社のホームページと LP（1ページのサイト）の制作・保守</span>
        </h1>
        <p class="hero__lead">公開した日から、仕組みは動きはじめる。そのあとの保守まで、つくった本人が見続けます。</p>
        <p class="hero__facts">
          LP の制作は、保守とあわせて<strong>{yen(bundleFrom)}</strong>から（保守は月<strong>{yen(careFrom)}</strong>から）、LP だけなら<strong>{yen(standaloneFrom)}</strong>からです（{tax}）。テンプレートから選んでつくるので、お支払いの確認から最短<strong>{fastest}</strong>でお届けします。
        </p>
        <div class="button-row">
          <a class="button button--primary button--large" href="#lp">料金とプランを見る</a>
          <a class="button-row__link" href="#contact">無料で相談する</a>
        </div>
      </div>
      <figure class="grid__side hero__media">
        <Picture
          src={kaiyakuSp}
          alt="解約手帳の記事をスマートフォンで開いた画面。冒頭に最終確認日と、確かめた公式ページの一覧がある"
          widths={[288, 432, 576]}
          sizes="18rem"
          formats={['avif', 'webp']}
        />
        <figcaption>
          エレノアがつくって運営しているサイト<a href="#apps">{kaiyaku.name}</a>の記事。確かめた日付と公式ページを冒頭に書く仕組みです（{jaDate(kaiyaku.shotAt)}に撮影）。
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="wrap">
      <h2 class="section__title" id="services-title">頼めること</h2>
      <p class="section__lead">
        お店と小さな会社のサイトを、つくるところから公開後の保守まで引き受けます。窓口も制作も、最初から最後まで同じ開発者です。
      </p>
      <div class="grid offer">
        <div class="grid__main offer__main">
          <h3 class="offer__title">LP の制作</h3>
          <p class="offer__price"><strong>{yen(lpFrom)}</strong>から（{tax}）・最短{fastest}</p>
          <p>
            1ページで伝えるサイトを、制作者が1点ずつ確認したデザインから選んでつくります。やりとりはすべてメールで、お打ち合わせはありません。公開の前に実物をご確認いただき、{prices.pre_delivery_revisions}回まで手直しします。
          </p>
          <ul class="check-list">{lpIncludes.map((i) => <li>{i}</li>)}</ul>
          <p><a href="#lp">LP の料金とプランを見る</a></p>
        </div>
        <div class="grid__side offer__side">
          <div class="offer__item">
            <h3 class="offer__title">ホームページの制作（フルオーダー）</h3>
            <p class="offer__price"><strong>{yen(hp.price)}</strong>から（{tax}）・納期{hp.delivery_days}</p>
            <p>複数ページのホームページを、オンラインのお打ち合わせから構成と原稿までつくります。</p>
            <p><a href="/services.html#fullorder">フルオーダーの詳細</a></p>
          </div>
          <div class="offer__item">
            <h3 class="offer__title">公開後の保守と更新</h3>
            <p class="offer__price">月<strong>{yen(careFrom)}</strong>から（{tax}）</p>
            <p>表示の確認と、掲載内容の差し替えを続けます。</p>
            <p><a href="/services.html#care">保守と運用の詳細</a></p>
          </div>
        </div>
      </div>
      <p class="offer__more">
        予約や問い合わせの仕組み、サイトやサーバーの引っ越しなど、テンプレートに収まらないご相談もフルオーダーの中でお受けします。<a href="/services.html#extend">付随する機能の開発</a>
      </p>
    </div>
  </section>

  <section class="section section--minor" id="lp" aria-labelledby="lp-title">
    <div class="wrap">
      <h2 class="section__title" id="lp-title">料金とプラン</h2>
      <p class="section__lead">LP のデザインは3つの段から選べます。保守とあわせて申し込むと、制作料金が下がります。</p>
      <PriceTables />
      <p class="section__more">
        <a href="/services.html">各プランに含まれるもの・追加サービスの料金</a>
      </p>
    </div>
  </section>

  <section class="section section--minor" aria-labelledby="flow-title">
    <div class="wrap">
      <h2 class="section__title" id="flow-title">LP ができるまで</h2>
      <ul class="timeline" role="list">
        <li class="timeline__step">
          <p class="timeline__when"><span class="visually-hidden">手順</span><span class="timeline__num">1</span>お申し込みの日</p>
          <h3 class="timeline__title">プランを選んで、お支払い</h3>
          <p>
            料金表からプランを選び、お問い合わせからお知らせください。お支払いは{prices.payment_timing}（{prices.payment_methods.join('・')}）です。
          </p>
        </li>
        <li class="timeline__step">
          <p class="timeline__when"><span class="visually-hidden">手順</span><span class="timeline__num">2</span>最短{fastest}</p>
          <h3 class="timeline__title">質問に答えて、実物を確かめる</h3>
          <p>
            お店のことや載せたいことを、メールでうかがいます。お支払いの確認から最短{fastest}で実物をお送りし、ご返信から{prices.revision_turnaround}で手直しします（{prices.pre_delivery_revisions}回まで）。
          </p>
        </li>
        <li class="timeline__step">
          <p class="timeline__when"><span class="visually-hidden">手順</span><span class="timeline__num">3</span>公開したあと</p>
          <h3 class="timeline__title">公開して、保守を続ける</h3>
          <p>公開したあとは、保守メンテナンス（月{yen(careFrom)}から）で、表示の確認と掲載内容の差し替えを続けます。</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="apps" aria-labelledby="products-title">
    <div class="wrap">
      <h2 class="section__title" id="products-title">つくったもの</h2>
      <p class="section__lead">自分のサービスも、自分で設計して運営しています。お客様のサイトにも、同じ考え方と仕組みを使います。</p>
      <div class="grid work">
        <figure class="grid__main shot shot--pc">
          <Picture
            src={kaiyakuPc}
            alt="解約手帳のトップページ。確かめた日付つきのサブスク解約手順の一覧"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 72rem) 40rem, 55vw"
            formats={['avif', 'webp']}
          />
          <figcaption>{kaiyaku.host} のトップページ（パソコン）。{jaDate(kaiyaku.shotAt)}に撮影。</figcaption>
        </figure>
        <figure class="grid__main shot shot--sp">
          <Picture
            src={kaiyakuSp}
            alt="解約手帳の記事をスマートフォンで開いた画面。冒頭に最終確認日と、確かめた公式ページの一覧がある"
            widths={[288, 432, 576]}
            sizes="18rem"
            formats={['avif', 'webp']}
          />
          <figcaption>{kaiyaku.host} の記事（スマートフォン）。{jaDate(kaiyaku.shotAt)}に撮影。</figcaption>
        </figure>
        <div class="grid__side work__body">
          <h3 class="work__title">{kaiyaku.name}</h3>
          <p>
            {kaiyaku.summary}です。手順や金額は変わるので、公式ページで確かめた日付が無い記事は公開できない仕組みにしています。
          </p>
          <dl class="facts">
            <div>
              <dt>公開</dt>
              <dd>{jaDate(kaiyaku.since)}から運用中</dd>
            </div>
            <div>
              <dt>担当</dt>
              <dd>企画・設計・制作・記事の検査の仕組み・運用</dd>
            </div>
            <div>
              <dt>URL</dt>
              <dd><a href={kaiyaku.url}>{kaiyaku.host}</a></dd>
            </div>
          </dl>
          <p><a href="/products.html#kaiyaku">解約手帳の設計を読む</a></p>
        </div>
      </div>
      <div class="work work--small">
        <div class="work__body">
          <h3 class="work__title">このサイト</h3>
          <p>
            料金は1か所のデータから、料金表と特定商取引法に基づく表示の両方をつくり、食い違いがないかを公開のたびに機械で確かめています。作り直しても URL が1つも変わらないことも、同じように確かめています。
          </p>
          <p><a href="/products.html#this-site">このサイトの設計を読む</a></p>
        </div>
      </div>
      <p class="section__more">スマートフォンアプリの SONO-HINO と、人物相関図アプリのヒトモヨウは、ストアでの公開を準備しています。</p>
    </div>
  </section>

  <section class="section section--minor" aria-labelledby="about-title">
    <div class="wrap">
      <Person headingId="about-title" heading="つくる人">
        <p>
          はじめまして、エレノア代表の{op.representative}です。以前は外資系企業でシステムエンジニアを、いまは外資系コンサルティングファームに勤めています。エレノアでは、お店と小さな会社のサイトをつくり、公開後の保守を続けています。
        </p>
        <p>最初のご相談から公開後の保守まで、担当は代表ひとりです。途中で担当者が替わることはありません。いただいたメールには、私が直接お返事します。</p>
        <p><a href="/company.html#profile">代表のプロフィールと会社概要</a></p>
      </Person>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section section--minor" aria-labelledby="blog-title">
        <div class="wrap">
          <h2 class="section__title" id="blog-title">ブログ</h2>
          <ul class="article-list">
            {posts.map((p) => (
              <li class="article-list__item">
                <a class="article-list__link" href={postUrl(p)}>
                  {p.data.title}
                </a>
                <p class="article-list__meta">
                  {p.data.category}・<time datetime={ymd(p.data.published_at)}>{ymd(p.data.published_at)}</time>
                </p>
              </li>
            ))}
          </ul>
          <p class="section__more">
            <a href="/blog.html">ブログの記事一覧</a>
          </p>
        </div>
      </section>
    )
  }

  <section class="section section--sub" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 class="section__title" id="contact-title">お問い合わせ</h2>
      <p class="section__lead">ご相談・お見積もりは無料です。いまのお困りごとを、そのままお書きください。</p>
      <div class="grid contact">
        <div class="grid__main"><ContactForm /></div>
        <aside class="grid__side contact__aside" aria-labelledby="contact-direct-title">
          <h3 id="contact-direct-title">メールと電話</h3>
          <dl class="facts">
            <div>
              <dt>返信</dt>
              <dd>原則1営業日以内に、メールでお返事します</dd>
            </div>
            <div>
              <dt>メール</dt>
              <dd><a href={`mailto:${op.email}`}>{op.email}</a></dd>
            </div>
            <div>
              <dt>電話</dt>
              <dd>{op.phone}（留守番電話でお受けし、メールで折り返します）</dd>
            </div>
            <div>
              <dt>地域</dt>
              <dd>{SITE.area}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>
</Base>
